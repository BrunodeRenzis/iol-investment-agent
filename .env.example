# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Read-only application policy (not a broker credential)
# NEVER put IOL username/password/access/refresh tokens in .env or environment.
# Manual verification uses hidden terminal input in a separate local process.
# IOL origins are fixed in packages/iol, never configurable here.
IOL_READ_ONLY=true

# Database (future)
DATABASE_URL=

# OpenAI (future; do not populate until AI phase)
OPENAI_API_KEY=

# Anthropic (future; do not populate until AI phase)
ANTHROPIC_API_KEY=
